rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ============================================
    // THIS BUCKET IS NOT USED BY THE APP — DENY EVERYTHING.
    // ============================================
    // Confirmed by checking the actual client code, not assumption:
    //   - js/firebase-config.js never imports "firebase-storage.js" or
    //     calls getStorage(). The Firebase Storage SDK is never even
    //     loaded on any page.
    //   - No file in the codebase calls uploadBytes/uploadBytesResumable,
    //     ref(storage, ...), or getDownloadURL from the Storage SDK.
    //   - Every real upload (student ID photos, Hand Notes/Class
    //     Slides/Images, blog images, avatars) goes through Cloudinary
    //     via uploadToCloudinary() (see js/firebase-config.js's
    //     CLOUDINARY_* constants and every *.js file that imports them).
    //   - js/view.js keeps "firebasestorage.googleapis.com" in its
    //     ALLOWED_HOSTS allowlist only as defensive belt-and-braces for
    //     rendering a URL, not because anything writes there.
    //
    // The previous version of this file (paths like /resources/{uid},
    // /student-ids/{uid}, /avatars/{uid}, /blog/{uid}) was written as if
    // students sign in with Firebase Auth and upload directly to this
    // bucket (request.auth.uid, hasActiveResourceAccess() querying
    // Firestore). Neither is true — only the admin panel ever calls
    // signInWithEmailAndPassword (see js/admin.js), so under the old
    // rules request.auth.uid was never a student's uid,
    // hasActiveResourceAccess() could never resolve a real registration
    // by uid, and reads from /avatars/{uid} were flatly public. None of
    // that gated anything a real request in this app ever sent — the
    // rules were dead weight that looked like protection.
    //
    // A storage bucket with no legitimate traffic should default-deny,
    // not carry rules for paths nothing writes to: if the bucket is ever
    // activated by mistake (a stray script, a console upload, a future
    // feature added without updating this file), the safe default is
    // that nothing is readable or writable until rules are deliberately
    // written for that real use case.
    //
    // If Firebase Storage becomes real for this app in the future (e.g.
    // migrating off Cloudinary), this file needs to be rewritten from
    // scratch against however that feature actually authenticates and
    // uploads — copying the shape below is not a starting point, since
    // it intentionally grants nothing.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
