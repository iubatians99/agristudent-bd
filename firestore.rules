rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // ADMIN CHECK — used everywhere a comment below says
    // "admin panel only" / "admin-only".
    // ============================================
    // SECURITY FIX: every one of those spots previously read
    // `request.auth != null` — i.e. "any Firebase Auth session", not
    // "an admin session". That happened to work in practice ONLY
    // because js/admin.js is the sole place in the app that ever calls
    // signInWithEmailAndPassword(); no other page signs a student in
    // with Firebase Auth. But admin.js's own admin check
    // (`token.claims.admin !== true` → signOut()) is a CLIENT-SIDE UI
    // gate — it decides what the browser shows, not what Firestore
    // allows. Anyone holding ANY valid Firebase Auth account for this
    // project (a leftover test account created in the console, a
    // second admin who never got the custom claim set via
    // scripts/set-admin-claim.mjs, or any account created through a
    // sign-in method enabled later) could bypass the admin.js UI
    // entirely and call the Firestore SDK directly with full
    // update/delete rights over registrations, resources, terms,
    // messages, classroom codes, unlock grants, coffee requests, blog
    // moderation, etc. Requiring the actual `admin` custom claim here
    // closes that gap without changing behavior for the real admin
    // account, which already has the claim.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ============================================
    // REGISTRATIONS: Student signup + OTP verification
    // ============================================
    // Students are auto-approved once the email OTP is verified. Admin authentication
    // is not part of registration anymore. "list: if true" remains public because
    // the site uses it for live counters and email/ID lookups.
    //
    // The live registration counter and resource lookups run unauthenticated,
    // so list access remains public.
    match /registrations/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['studentIdNumber', 'email', 'status']) &&
        request.resource.data.status == "verified" &&
        request.resource.data.studentIdNumber is string &&
        request.resource.data.studentIdNumber.size() > 0 &&
        request.resource.data.studentIdNumber.size() < 50 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.registrationCredits == 5;

      allow list: if true;

      // Individual get is scoped the same as list (already public above) —
      // gating it further on status caused false "Missing or insufficient
      // permissions" errors for accounts whose status wasn't the exact
      // string "verified" (e.g. legacy records), even though the SAME data
      // is already readable via the list query. No real security is lost:
      // list already exposes every field on every registration.
      allow get: if true;

      // Admin panel only (js/admin.js approve/reject + generic edit modal),
      // OR a student updating just their own profile photo, OR a student
      // setting/resetting their own login password (js/login.js reset flow,
      // js/profile.js password section). Students never hold a Firebase
      // Auth session (same trust model as the rest of this file), so this
      // can't verify "your own" doc beyond knowing its ID — consistent
      // with the public-write-with-field-validation model used for
      // blogPosts/resources elsewhere in this file. Each branch is scoped
      // tightly so it can ONLY ever touch its one field, with the shape
      // that field must have (a real Cloudinary URL, or a 64-character
      // SHA-256 hex hash — never the plaintext password itself, which
      // never travels to Firestore at all).
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl']) &&
        request.resource.data.avatarUrl is string &&
        request.resource.data.avatarUrl.matches('^https://res[.]cloudinary[.]com/.*')
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordHash']) &&
        request.resource.data.passwordHash is string &&
        request.resource.data.passwordHash.size() == 64
      );
      allow delete: if isAdmin();
    }

    // ============================================
    // RESOURCES: Lecture notes, past questions
    // ============================================
    // NOTE: js/resources.js uploads with NO Firebase Auth session, so
    // create must stay public. Hardening here comes from field
    // validation instead of an auth gate -- a doc can only be created
    // as "pending" with a valid resourceType and at least one file.
    match /resources/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['status', 'resourceType', 'courseCode', 'fileUrls']) &&
        request.resource.data.status == "pending" &&
        request.resource.data.resourceType in ["slides_notes", "previous_questions"] &&
        request.resource.data.courseCode is string &&
        request.resource.data.courseCode.size() > 0 &&
        request.resource.data.fileUrls is list &&
        request.resource.data.fileUrls.size() > 0 &&
        request.resource.data.fileUrls.size() <= 20;

      allow get: if
        resource.data.status == "approved" ||
        isAdmin();

      // "list: if true" — same reasoning as registrations above. Students
      // never sign in, so there is no request.auth.token.email to check
      // "is this your own upload" against. Firestore can only grant a
      // `list` query if it can PROVE every possible matching doc satisfies
      // the rule from the query's own filters — a rule like
      // `resource.data.status == "approved"` cannot be proven for a query
      // that filters by uploaderEmail with no status filter, so Firestore
      // was rejecting that whole query outright (not just hiding
      // non-approved docs). That's what broke the upload/"credit" status
      // check in js/resources.js (hnCheckAndDisplayStatus) and the
      // profile page's upload history (js/profile.js) for any student
      // whose own upload was still pending or was rejected — exactly the
      // "credit not showing" bug. The resources.html/knowledge-hub.html
      // browsing views already filter to approved-only in their own
      // queries, so this doesn't change what visitors normally see.
      allow list: if true;

      // Admin panel only (approve/reject/edit in js/admin.js)
      allow update, delete: if isAdmin();
    }

    // ============================================
    // TERMS: Knowledge-hub glossary entries
    // ============================================
    // Same story as resources: js/knowledge-hub.js submits terms with
    // no auth session, so create stays public + validated.
    match /terms/{id} {
      // Students create pending terms. Authenticated admins may also create
      // already-approved terms (used by the Admin → Bulk Upload Terms tool).
      allow create: if
        request.resource.data.keys().hasAll(['status', 'name']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        (
          (request.resource.data.status == "pending" && request.auth == null) ||
          (request.resource.data.status == "approved" && isAdmin())
        );

      allow get: if
        resource.data.status == "approved" ||
        isAdmin();

      // See the matching comment on /resources/{id} above — same fix,
      // same reason (students' own pending/rejected contributions need
      // to be listable by uploaderEmail on their profile page).
      allow list: if true;

      allow update, delete: if isAdmin();
    }

    // ============================================
    // COURSES: Canonical course list (reference data)
    // ============================================
    // js/resources.js writes a new course doc (setDoc) the first time a
    // course code is seen, still unauthenticated. Because it's a plain
    // setDoc, Firestore treats this as "create" only when the doc
    // doesn't exist yet; once created, further writes to the same doc
    // hit the "update" branch below and require admin auth.
    match /courses/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['courseCode', 'courseName']) &&
        request.resource.data.courseCode is string &&
        request.resource.data.courseCode.size() > 0;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // FACULTY: Teacher Recommendation directory (admin-managed)
    // ============================================
    // Admin creates/edits faculty profiles (name, dept, photo, courses
    // taught) from the "Faculty" admin tab. The one thing a public
    // review submission is allowed to touch is the aggregate "stats"
    // map, so a student's browser can bump the counters the moment
    // their own review posts — same trade-off the rest of this file
    // makes everywhere students never hold a Firebase Auth session (see
    // blogPosts.likesCount above). Full per-field arithmetic validation
    // isn't practical for a dynamic tagCounts map, so the real anti-spam
    // backstop is the facultyReviews doc-id trick below (one write per
    // student per faculty) plus admin's ability to edit/delete any
    // faculty doc or review at any time.
    match /faculty/{id} {
      // Public directory: approved faculty only. Admins can see every
      // record, including pending submissions that have not been published.
      allow get, list: if isAdmin() || resource.data.status == "approved";

      // Admin-created profiles are immediately approved. A normal site
      // account may submit only a pending suggestion, and the registration
      // record is checked server-side so the browser cannot submit as an
      // unregistered/removed account. The submitted email must also match
      // the verified registration used for the submission.
      allow create: if
        (isAdmin() &&
          request.resource.data.keys().hasAll(['name', 'department', 'courseCodes']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 160 &&
          request.resource.data.department is string &&
          request.resource.data.department.size() > 0 &&
          request.resource.data.department.size() <= 160 &&
          request.resource.data.courseCodes is list &&
          request.resource.data.courseCodes.size() > 0 &&
          request.resource.data.courseCodes.size() <= 20)
        ||
        (!isAdmin() &&
          request.resource.data.keys().hasAll([
            'name', 'department', 'courseCodes', 'status',
            'submittedByRegId', 'submittedByEmail', 'submittedByName'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 160 &&
          request.resource.data.department is string &&
          request.resource.data.department.size() > 0 &&
          request.resource.data.department.size() <= 160 &&
          (!('designation' in request.resource.data) ||
            (request.resource.data.designation is string && request.resource.data.designation.size() <= 120)) &&
          request.resource.data.courseCodes is list &&
          request.resource.data.courseCodes.size() > 0 &&
          request.resource.data.courseCodes.size() <= 20 &&
          request.resource.data.status == 'pending' &&
          request.resource.data.submittedByRegId is string &&
          request.resource.data.submittedByRegId.size() > 0 &&
          request.resource.data.submittedByEmail is string &&
          request.resource.data.submittedByEmail.size() > 0 &&
          request.resource.data.submittedByEmail.size() <= 200 &&
          request.resource.data.submittedByName is string &&
          request.resource.data.submittedByName.size() <= 160 &&
          get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data.status == 'verified' &&
          (!('removed' in get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data) || get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data.removed != true) &&
          get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data.email == request.resource.data.submittedByEmail &&
          (!('photoUrl' in request.resource.data) ||
            (request.resource.data.photoUrl is string &&
             (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('^https://res[.]cloudinary[.]com/.*'))))
        );

      // Only the aggregate stats may be changed by a non-admin. All faculty
      // identity fields, including a pending submission, remain admin-owned.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.department == resource.data.department
      );
      allow delete: if isAdmin();
    }

    // ============================================
    // COURSE SUGGESTIONS: student-suggested course codes for an
    // existing faculty member, from the "Suggest a course" button on a
    // faculty profile. Always lands as "pending" for admin review —
    // admin approves by adding the code to the faculty's own
    // courseCodes (in the faculty match block above) and then removes
    // the suggestion doc; nothing here ever changes a faculty record
    // directly.
    // ============================================
    match /courseSuggestions/{id} {
      allow get, list: if isAdmin();
      allow create: if !isAdmin() &&
        request.resource.data.keys().hasAll([
          'facultyId', 'facultyName', 'courseCode', 'status',
          'submittedByRegId', 'submittedByEmail', 'submittedByName'
        ]) &&
        request.resource.data.facultyId is string && request.resource.data.facultyId.size() > 0 &&
        request.resource.data.facultyName is string && request.resource.data.facultyName.size() <= 160 &&
        request.resource.data.courseCode is string &&
        request.resource.data.courseCode.size() > 0 && request.resource.data.courseCode.size() <= 20 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.submittedByRegId is string && request.resource.data.submittedByRegId.size() > 0 &&
        request.resource.data.submittedByEmail is string && request.resource.data.submittedByEmail.size() > 0 &&
        request.resource.data.submittedByEmail.size() <= 200 &&
        request.resource.data.submittedByName is string && request.resource.data.submittedByName.size() <= 160 &&
        get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data.status == 'verified' &&
        (!('removed' in get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data) || get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data.removed != true) &&
        get(/databases/$(database)/documents/registrations/$(request.resource.data.submittedByRegId)).data.email == request.resource.data.submittedByEmail;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // FACULTY REVIEWS: Teacher Recommendation ratings
    // ============================================
    // Doc id = `${facultyId}_${reviewerRegId}` — same one-doc-per-pair
    // trick as blogLikes above. "create" only ever fires on a path with
    // no existing document, so a second submission from the same
    // student for the same faculty lands on this SAME id and is
    // evaluated as an "update" instead — which nothing below allows for
    // a non-admin — so it's rejected outright. That's the real
    // one-review-per-student-per-faculty enforcement, not just a
    // client-side check (js/faculty.js reads a "permission-denied" here
    // as "you've already reviewed this faculty").
    //
    // Non-anonymous reviews are accountable to a real registration, so
    // they post as "approved" immediately and js/faculty.js increments
    // the faculty's public stats right away. An anonymous review hides
    // its author on the public page (reviewerName is never rendered
    // when isAnonymous is true) but still carries reviewerRegId here for
    // admin moderation — it can only be created as "pending" and only
    // counts toward public stats once admin approves it in the "Faculty
    // Reviews" admin tab (js/admin.js loadFacultyReviews).
    match /facultyReviews/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['facultyId', 'reviewerRegId', 'rating', 'recommended', 'tags', 'isAnonymous', 'status', 'submittedAt']) &&
        id == (request.resource.data.facultyId + '_' + request.resource.data.reviewerRegId) &&
        request.resource.data.facultyId is string && request.resource.data.facultyId.size() > 0 &&
        request.resource.data.reviewerRegId is string && request.resource.data.reviewerRegId.size() > 0 &&
        request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.recommended is bool &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() >= 1 && request.resource.data.tags.size() <= 6 &&
        request.resource.data.isAnonymous is bool &&
        (!('courseCode' in request.resource.data) || (request.resource.data.courseCode is string && request.resource.data.courseCode.size() <= 50)) &&
        (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 400)) &&
        get(/databases/$(database)/documents/registrations/$(request.resource.data.reviewerRegId)).data.status == 'verified' &&
        (!('removed' in get(/databases/$(database)/documents/registrations/$(request.resource.data.reviewerRegId)).data) || get(/databases/$(database)/documents/registrations/$(request.resource.data.reviewerRegId)).data.removed != true) &&
        (
          (request.resource.data.isAnonymous == true && request.resource.data.status == "pending") ||
          (request.resource.data.isAnonymous == false && request.resource.data.status == "approved")
        );

      // Public read — js/faculty.js filters to status == "approved" for
      // the public page; admin's moderation queue reads every status.
      allow read: if true;

      // Approve / reject / delete: admin only (js/admin.js).
      allow update, delete: if isAdmin();
    }

    // ============================================
    // TIMELINE: Academic calendar (admin-only, unchanged)
    // ============================================
    match /timeline/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // MESSAGES: Contact / help form (js/help.js)
    // ============================================
    // Real schema is {name, email, message, submittedAt, read} -- there
    // is no "uid" field because the sender never signs in. The original
    // hardened draft required request.auth.uid == uid, which no
    // submission could ever satisfy. Validated instead of auth-gated,
    // and "read" must start false so a sender can't mark their own
    // message pre-read.
    match /messages/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000 &&
        (!('read' in request.resource.data) || request.resource.data.read == false);

      // Admin-only inbox (js/admin.js loadMessages)
      allow read, update, delete: if isAdmin();
    }

    // ============================================
    // CLASSROOM CODES: "Send Us Classroom Code" (resources.html)
    // ============================================
    // Same pattern as messages above: students never sign in, so create
    // stays public + validated; only the admin panel can read/manage them.
    match /classroomCodes/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['classroomCode', 'status']) &&
        request.resource.data.classroomCode is string &&
        request.resource.data.classroomCode.size() > 0 &&
        request.resource.data.classroomCode.size() <= 200 &&
        request.resource.data.status == "new";

      // Public read is required now: the classroom-code unlock flow
      // (js/resources.js, slides-notes.html gate) checks for duplicate
      // codes with a "where normalizedCode ==" query before accepting a
      // new one, and js/profile.js reads a student's own submitted codes
      // to compute their remaining access time — neither runs with a
      // Firebase Auth session (see the trust-model note at the top of
      // this file), so both need list/get open the same way
      // resources/blogPosts/messages already are.
      allow list, get: if true;

      // Admin panel only (js/admin.js loadClassroomCodes / moderation).
      allow update, delete: if isAdmin();
    }

    // ============================================
    // AD UNLOCKS: "Unlock by Watching an Ad" (slides-notes.html gate)
    // ============================================
    // Same public-write-with-validation trust model as classroomCodes
    // above (students never sign in) — but unlike a classroom code, this
    // grants access the instant it's created, no admin approval step, so
    // the validation here is what stands between a student and a free
    // unlock: it must look like a real completed-ad record (a target
    // file, the "ad" kind, and a watchedSeconds count that isn't 0/negative).
    match /adUnlocks/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['targetFileId', 'kind', 'watchedSeconds']) &&
        request.resource.data.kind == "ad" &&
        request.resource.data.targetFileId is string &&
        request.resource.data.targetFileId.size() > 0 &&
        request.resource.data.targetFileId.size() <= 200 &&
        request.resource.data.watchedSeconds is number &&
        request.resource.data.watchedSeconds >= 10;

      // js/resources.js reads a student's own ad-unlock history (no
      // Firebase Auth session, same trust model as classroomCodes/
      // resources above) to compute their remaining per-file access time.
      allow list, get: if true;

      // Admin panel only — reviewing/deleting for abuse monitoring.
      allow update, delete: if isAdmin();
    }

    // ============================================
    // ADMIN MANUAL UNLOCKS — grants custom access directly from Admin.
    // Students can read their own unlock records through the existing public
    // access-query model, but only an authenticated admin can create/change
    // these grants.
    match /manualUnlocks/{id} {
      allow create: if
        isAdmin() &&
        request.resource.data.keys().hasAll(['kind','fromEmail','userEmail','unlockType','days','durationMs']) &&
        request.resource.data.kind == "manual" &&
        request.resource.data.fromEmail is string && request.resource.data.fromEmail.size() > 0 &&
        request.resource.data.userEmail is string && request.resource.data.userEmail.size() > 0 &&
        request.resource.data.unlockType in ["all_resources","hand_notes","class_slides","images"] &&
        request.resource.data.days is number && request.resource.data.days >= 1 &&
        request.resource.data.durationMs is number && request.resource.data.durationMs >= 86400000;
      allow list, get: if true;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // FILE UNLOCK CREDITS — one uploaded Hand Note file = one credit.
    match /fileUnlocks/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['kind','fromEmail','targetFileId','sourceResourceId']) &&
        request.resource.data.kind == "file_unlock" &&
        request.resource.data.fromEmail is string && request.resource.data.fromEmail.size() > 0 &&
        request.resource.data.targetFileId is string && request.resource.data.targetFileId.size() > 0 &&
        request.resource.data.sourceResourceId is string && request.resource.data.sourceResourceId.size() > 0 &&
        // Every legitimate file-unlock grant used by js/resources.js is
        // 6h (upload-gate unlock) or 36h (spending a wallet credit) — cap
        // at 48h so a doc written directly against the SDK (there is no
        // Firebase Auth session gating this create, by design — see the
        // top-of-file trust-model note) can't hand out an arbitrarily
        // long or effectively-infinite access window. Previously this
        // field was not validated here at all, even though js/access.js
        // trusts whatever number it finds in it.
        (!('durationMs' in request.resource.data) ||
          (request.resource.data.durationMs is number &&
           request.resource.data.durationMs > 0 &&
           request.resource.data.durationMs <= 172800000));
      allow list, get: if true;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // FOLDER LIFETIME UNLOCKS — Class Slides / Images. Admin can revoke.
    match /folderUnlocks/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['kind','fromEmail','targetFileId','category','revoked']) &&
        request.resource.data.kind == "folder_lifetime" &&
        request.resource.data.fromEmail is string && request.resource.data.fromEmail.size() > 0 &&
        request.resource.data.targetFileId is string && request.resource.data.targetFileId.size() > 0 &&
        request.resource.data.category in ["hand_notes","class_slides","images"] &&
        request.resource.data.revoked == false;
      allow list, get: if true;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // COFFEE SUPPORT REQUESTS — student submits payment proof; admin reviews.
    match /coffeeRequests/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['fromEmail','fromName','senderNumber','transactionId','amount','status','submittedAt']) &&
        request.resource.data.fromEmail is string && request.resource.data.fromEmail.size() > 0 &&
        request.resource.data.senderNumber is string && request.resource.data.senderNumber.size() > 0 &&
        request.resource.data.transactionId is string && request.resource.data.transactionId.size() > 0 &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.status == "pending";
      allow list, get: if true;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // GLOBAL RESOURCE LOCK — admin-only control used to invalidate all
    // existing non-owner file unlock grants at once.
    match /resourceLocks/{id} {
      allow get, list: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // SETTINGS: Configuration (admin-only, unchanged)
    // ============================================
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // ADMIN MESSAGES: Admin → Student inbox (js/admin.js "Notify User",
    // js/inbox.js, js/profile.js Inbox section)
    // ============================================
    // Only the admin panel (a real Firebase Auth session) may compose and
    // send a message to a student. Students never hold a Firebase Auth
    // session (same trust model as the rest of this file), so reading
    // "messages sent to me" and marking one "read" have to stay public
    // and be locked down with field validation instead of an auth check
    // — js/profile.js filters its own query to the signed-in student's
    // own regId, and the update rule below can ONLY ever flip
    // read:false -> true (plus its timestamp), never touch the sender,
    // recipient, subject or body.
    match /adminMessages/{id} {
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['toRegId', 'toEmail', 'subject', 'body', 'sentAt', 'read']) &&
        request.resource.data.toRegId is string && request.resource.data.toRegId.size() > 0 &&
        request.resource.data.toEmail is string && request.resource.data.toEmail.size() > 0 &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 5000 &&
        request.resource.data.read == false;

      // Public list/get so the recipient (no auth session) can query their
      // own inbox by regId — same pattern as classroomCodes/adUnlocks above.
      allow list, get: if true;

      // A student may only ever mark their own received message as read
      // (read:false -> true, plus readAt) — every other field is frozen.
      // The admin panel can do anything (delete, edit) via its own auth.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read == true
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // BLOG POSTS: Facebook-style student timeline (js/blog.js)
    // ============================================
    // Same trust model as /resources and /terms above: students never
    // hold a Firebase Auth session (only the admin panel does), so
    // create/engagement writes have to stay public and be locked down
    // with field validation instead of an auth check.
    //
    // Unlike /resources, a blog post is visible to everyone the moment
    // it's submitted (status "pending") — the product requirement is
    // that it shows up in the public timeline immediately with a
    // "Not verified" watermark, then flips to an "Approved" badge once
    // an admin reviews it. So read access does not gate on status here;
    // js/blog.js chooses to hide "rejected" posts client-side instead.
    match /blogPosts/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['title', 'content', 'authorEmail', 'authorRegId', 'status', 'likesCount', 'commentsCount', 'sharesCount', 'views']) &&
        request.resource.data.status == "pending" &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 20000 &&
        request.resource.data.authorEmail is string && request.resource.data.authorEmail.size() > 0 &&
        request.resource.data.authorRegId is string && request.resource.data.authorRegId.size() > 0 &&
        request.resource.data.likesCount == 0 &&
        request.resource.data.commentsCount == 0 &&
        request.resource.data.sharesCount == 0 &&
        request.resource.data.views == 0;

      // Public read is retained because student accounts are not Firebase-authenticated.
      // js/blog.js enforces the visibility rule: approved posts are public; pending/rejected
      // posts are rendered only when their author email matches the current session.
      allow read: if true;

      // Engagement counters (like/unlike, view, share) are bumped by
      // anonymous-but-registered visitors with no auth token, so they're
      // allowed as long as the write touches ONLY one counter field and
      // moves it by exactly +/-1 — never a moderation field (status),
      // never the content, and never an arbitrary jump in count. The
      // likesCount branch also floors at 0 — an unlike can never push it
      // negative, even from a client bug, so a bad "unlike" caps out at
      // 0 instead of quietly going negative forever.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
        request.resource.data.likesCount >= 0 &&
        (request.resource.data.likesCount == resource.data.likesCount + 1 ||
         request.resource.data.likesCount == resource.data.likesCount - 1)
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.views + 1
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharesCount']) &&
        request.resource.data.sharesCount == resource.data.sharesCount + 1
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
        (request.resource.data.commentsCount == resource.data.commentsCount + 1 ||
         request.resource.data.commentsCount == resource.data.commentsCount - 1)
      );

      // Allow a student to edit their OWN post (title, content, images).
      // Students never hold a Firebase Auth session (same trust model as
      // the rest of this file — see registrations.avatarUrl above), so
      // this can never require request.auth != null; the previous version
      // of this rule did, which meant every edit was silently denied by
      // Firestore and never actually saved. Ownership can't be verified
      // server-side without auth, so trust is instead placed in tight
      // field validation: only title/content/imageUrls/status/editedAt/
      // editedBy may change (authorEmail, authorRegId, and every counter
      // are locked), and the write must move status to "pending_edit" —
      // it can never re-approve itself or resurrect a rejected post as
      // approved. The edit updates the SAME document in place; it never
      // creates a new one, and it goes back through admin review exactly
      // like a brand-new post did.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'imageUrls', 'status', 'editedAt', 'editedBy']) &&
        request.resource.data.status == "pending_edit" &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 20000;

      // Deleting a post: students never hold a Firebase Auth session, and
      // even the admin panel's own session email doesn't match
      // authorEmail (admin is deleting someone else's post, not their
      // own) — so the previous `resource.data.authorEmail ==
      // request.auth.token.email` check failed for BOTH the student's
      // own delete button (js/blog.js, js/profile.js) and admin
      // moderation deletes. Ownership can't be verified server-side
      // without an auth session tied to the student, so this trusts the
      // client the same way the rest of this file already does for
      // blogLikes deletes, avatarUrl updates, etc. — every UI entry
      // point already gates the delete button behind a client-side
      // "is this your own post" (or admin) check before calling this.
      //
      // FIX: previously "if true", which let any unauthenticated visitor
      // delete ANY post (including already-approved ones) directly via
      // the Firestore SDK, bypassing the UI's ownership check entirely.
      // Narrowed so unauthenticated deletes only work while a post is
      // still pending/pending_edit/rejected — i.e. not yet public-approved
      // — which covers the legitimate "student deletes their own draft"
      // case. Deleting an approved post now requires an admin session.
      allow delete: if isAdmin() ||
        resource.data.status in ["pending", "pending_edit", "rejected"];
    }

    // ============================================
    // BLOG COMMENTS: attached to a blogPosts/{postId}
    // ============================================
    match /blogComments/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['postId', 'text', 'authorEmail', 'authorRegId']) &&
        request.resource.data.postId is string && request.resource.data.postId.size() > 0 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.authorEmail is string && request.resource.data.authorEmail.size() > 0 &&
        request.resource.data.authorRegId is string && request.resource.data.authorRegId.size() > 0;

      allow read: if true;

      // Admin moderation only — deleting a comment does not (and cannot,
      // without auth) also decrement the post's commentsCount here; that
      // decrement happens client-side via the blogPosts/{id} counter
      // update rule above, in the same admin action.
      allow update, delete: if isAdmin();
    }

    // ============================================
    // BLOG LIKES: one doc per (post, student) pair, doc id = `${postId}_${normalizedEmail}`
    // ============================================
    // Existence of the doc IS the "liked" state, so create = like and
    // delete = unlike. There's no auth to prove the caller owns the
    // email baked into the doc id, but that's the same trade-off the
    // rest of this file already makes for every unauthenticated write.
    match /blogLikes/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['postId', 'email']) &&
        request.resource.data.postId is string && request.resource.data.postId.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        id == (request.resource.data.postId + '_' + request.resource.data.email);

      allow read: if true;
      allow delete: if true;
      allow update: if false;
    }
  }
}
